# Neon PostgreSQL connection string. Keep real credentials in .env only.
DATABASE_URL=
# Optional direct migration/administration URL. Milestone 1 does not use it.
DIRECT_URL=
DATABASE_POOL_SIZE=5
DATABASE_MAX_OVERFLOW=5

# LLM completion provider. Supported values: openai, openrouter, openai_compatible.
LLM_PROVIDER=openai
LLM_API_KEY=
LLM_BASE_URL=
LLM_MODEL=

# Embeddings may use a different OpenAI-compatible provider from the LLM.
EMBEDDING_PROVIDER=openai
EMBEDDING_API_KEY=
EMBEDDING_BASE_URL=
EMBEDDING_MODEL=text-embedding-3-small

DEBUG=false

# Used only by database integration tests. Never point this at production.
TEST_DATABASE_URL=
