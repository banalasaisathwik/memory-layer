# Neon PostgreSQL connection string. Keep real credentials in .env only.
DATABASE_URL=
# Optional direct migration URL. Alembic prefers this over DATABASE_URL.
DIRECT_URL=
DATABASE_POOL_SIZE=5
DATABASE_MAX_OVERFLOW=5

# Rolling conversation context stays compact and leaves recent messages outside summaries.
SUMMARY_TRIGGER_MESSAGES=20
SUMMARY_RECENT_KEEP=6
EXTRACTION_RECENT_MESSAGES=6
EXTRACTION_LEXICAL_MESSAGES=3
EXTRACTION_SEMANTIC_MESSAGES=3
# Final, deduplicated cap across lexical and semantic older-message context.
EXTRACTION_OLD_MESSAGES=6

# LLM completion provider. Supported values: openai, openrouter, openai_compatible.
LLM_PROVIDER=openai
LLM_API_KEY=
LLM_BASE_URL=
LLM_MODEL=

# Embeddings may use a different OpenAI-compatible provider from the LLM.
EMBEDDING_PROVIDER=openai
EMBEDDING_API_KEY=
EMBEDDING_BASE_URL=
EMBEDDING_MODEL=text-embedding-3-small

DEBUG=false

# Used only by database integration tests. Never point this at production.
TEST_DATABASE_URL=

# Used only by evals/ (LoCoMo, benchmark, ablation, recovery workloads). Never
# falls back to TEST_DATABASE_URL or DATABASE_URL. Point this at a dedicated
# local PostgreSQL instance, e.g.:
# postgresql+psycopg://memory_eval:memory_eval_pass@localhost:5433/memory_layer_eval
EVAL_DATABASE_URL=
# When "true", evals/ refuses to run unless EVAL_DATABASE_URL's host is
# localhost/127.0.0.1 (optional safety guard; leave unset to allow remote
# eval databases, e.g. for CI benchmarking).
EVAL_REQUIRE_LOCAL_DB=
